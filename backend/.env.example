# Copy to .env and fill in. .env is gitignored — never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Extra allowed CORS origins (non-extension), comma-separated.
# ALLOWED_ORIGINS=http://localhost:5173

# Chrome extension ids allowed to call the API, comma-separated (see chrome://extensions).
# Empty = any extension, for local development only. Set it before deploying.
# EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop
